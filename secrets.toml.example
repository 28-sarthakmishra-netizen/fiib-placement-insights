# Copy everything below into Streamlit Cloud > your app > Settings > Secrets.
# (To run on your own computer, save a copy of this file as .streamlit/secrets.toml.)
# Never upload a file containing real keys to GitHub.

GEMINI_API_KEY = "paste your Gemini key from aistudio.google.com"
TAVILY_API_KEY = "tvly-paste your Tavily key from app.tavily.com"

# Passcode for the New assessment and CMC panel pages
CMC_PASSCODE = "choose a passcode for the CMC team"

# Google Sheet connector (see apps_script/Code.gs)
SHEETS_WEBAPP_URL = "https://script.google.com/macros/s/XXXXXXXX/exec"
SHEETS_TOKEN = "the same password you put in Code.gs"

# Any long random text; keeps reviewer emails scrambled. Set it once and never change it.
REVIEW_SALT = "type any long random text here"

# Optional: force a specific Gemini model
# GEMINI_MODEL = "gemini-3.6-flash"
